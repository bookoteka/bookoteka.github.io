---
interface Props {
  nazwa: string,
  wersja: string,
  opis: string,
  pigulki: string[],
  linkGH: string,
  rout: string
}

const {nazwa, wersja, opis, pigulki, linkGH, rout} = Astro.props
---

<article class="bg-white/90 p-8 rounded-2xl border border-amber-200/60 shadow-xs flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-bold text-slate-900">{nazwa}</h2>
      </div>
      <span class="px-3 py-1 text-xs font-semibold text-emerald-800 bg-emerald-100 rounded-full">
        {wersja}
      </span>
    </div>
          
    <p class="text-slate-600 mb-6 leading-relaxed">
      {opis}
    </p>

    <div class="flex flex-wrap gap-2 mb-8">
      {pigulki.map((pig) => (
        <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-md">{pig}</span>
      ))}
    </div>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-slate-100">
    <a 
      href={linkGH} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-sm font-semibold text-slate-700 hover:text-slate-900 transition-colors"
    >
      GitHub &rarr;
    </a>
    <a 
      href=`/aplikacje/${rout}`
      class="bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-xs"
    >
      Szczegóły
    </a>
  </div>
</article>