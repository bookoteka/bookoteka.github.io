---
import { Image } from 'astro:assets';
import logo from '../assets/bookotekaapps.png';
---

<header class="border-b border-amber-200/60 bg-amber-50/90 backdrop-blur-md sticky top-0 z-50">
  <div class="w-full px-2 h-24 flex items-center justify-between">

    <a href="/" class="h-full py-2 flex items-center">
      <Image 
        src={logo} 
        alt="Logo Bookoteka Apps" 
        class="h-full w-auto object-contain"
      />
    </a>

    <nav class="flex items-center gap-6 text-base font-semibold text-slate-800">
      <a href="/" class="hover:text-black transition-colors">
        Główna
      </a>
      <a href="/aplikacje" class="hover:text-black transition-colors">
        Aplikacje
      </a>
      <a href="/o-nas" class="hover:text-black transition-colors">
        O nas
      </a>
      <a href="/kontakt" class="hover:text-black transition-colors">
        Kontakt
      </a>

      <a 
        href="https://github.com/bookoteka" 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-xl transition-all font-medium text-base shadow-xs"
      >
        GitHub
      </a>
    </nav>

  </div>
</header>