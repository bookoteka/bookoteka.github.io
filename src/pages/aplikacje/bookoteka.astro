---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/bookoteka.png';
import ss from '../../assets/bookoteka-screenshot.png';
import { Image } from 'astro:assets';
import SeparatorNiewidzialny from '../../components/SeparatorNiewidzialny.astro';
import PoleKodu from '../../components/PoleKodu.astro';
---

<Layout title="bookoteka — Desktopowa Aplikacja Czytelnicza | Bookoteka Apps">
  <section class="py-12 md:py-16 max-w-5xl mx-auto px-6">
    <!-- Górna sekcja: Logo + Nagłówek + Opis + Przyciski -->
    <div class="flex flex-col sm:flex-row items-start gap-6 md:gap-8 mb-12">
      <Image 
        src={logo} 
        alt="bookoteka logo" 
        width={160}
        height={160}
        class="w-32 h-32 md:w-40 md:h-40 shrink-0 object-contain rounded-2xl shadow-sm"
      />
      <div class="flex flex-col gap-4">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight">bookoteka</h1>
            <span class="px-3 py-1 text-xs font-semibold text-emerald-800 bg-emerald-100 rounded-full">
              v1.0.0
            </span>
          </div>
          <p class="text-lg text-slate-700 leading-relaxed">
            Pulpitowa aplikacja czytelnicza do zarządzania osobistą biblioteką, katalogowania książek oraz śledzenia postępów w czytaniu.
          </p>
        </div>

        <!-- Przyciski tuż pod opisem obok logo -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#instalacja" 
            class="bg-slate-900 hover:bg-slate-800 text-white font-semibold px-5 py-2.5 rounded-xl transition-all shadow-md text-sm text-center"
          >
            Pobierz najnowszą wersję
          </a>
          <a 
            href="https://github.com/bookoteka/bookoteka" 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-amber-100/80 hover:bg-amber-200/80 text-slate-900 font-semibold px-5 py-2.5 rounded-xl border border-amber-300/60 transition-all text-sm text-center"
          >
            Kod źródłowy na GitHubie
          </a>
        </div>
      </div>
    </div>

    <!-- Zrzut ekranu -->
    <div class="bg-white/90 p-3 md:p-4 rounded-3xl border border-amber-200/80 shadow-lg mb-16">
      <Image
        src={ss}
        alt="Zrzut ekranu aplikacji bookoteka" 
        class="rounded-2xl border border-slate-200/80 w-full h-auto object-contain bg-slate-50"
      />
    </div>

    <SeparatorNiewidzialny height='1.5'/>

    <!-- Możliwości -->
    <div class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">Możliwości aplikacji</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white/80 p-6 rounded-2xl border border-amber-200/60 shadow-xs">
          <div class="text-2xl mb-3">📖</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Osobista biblioteka</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kataloguj swoje książki, śledź swoją aktywność czytelniczą i porządkuj według własnych preferencji.
          </p>
        </div>

        <div class="bg-white/80 p-6 rounded-2xl border border-amber-200/60 shadow-xs">
          <div class="text-2xl mb-3">⚡</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Tryb Offline & lekkość</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Dzięki wykorzystaniu Tauri aplikacja uruchamia się błyskawicznie, zużywa znikome ilości pamięci RAM i działa w 100% offline.
          </p>
        </div>

        <div class="bg-white/80 p-6 rounded-2xl border border-amber-200/60 shadow-xs">
          <div class="text-2xl mb-3">📊</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Statystyki czytelnicze</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Śledź liczbę przeczytanych stron, ilość książek, formaty oraz gatunki w przejrzystym panelu podsumowań.
          </p>
        </div>

        <div class="bg-white/80 p-6 rounded-2xl border border-amber-200/60 shadow-xs">
          <div class="text-2xl mb-3">📄</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Raporty PDF</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Błyskawicznie generuj miesięczne i roczne raporty w formacie PDF
          </p>
        </div>
      </div>
    </div>

    <SeparatorNiewidzialny height='1.5'/>

    <!-- Stos technologiczny -->
    <div class="bg-amber-100/40 p-8 rounded-2xl border border-amber-200/60 mb-16">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Stos technologiczny</h2>
      <div class="flex flex-wrap gap-2">
        {['Tauri', 'React', 'TypeScript', 'TailwindCSS', 'DrizzleORM'].map((s) => (
          <span class="px-3 py-1 bg-white text-slate-800 text-xs font-semibold rounded-md border border-amber-200/60">{s}</span>
        ))}
      </div>
    </div>

    <SeparatorNiewidzialny height='1.5'/>

    <!-- Sekcja Instalacji -->
    <div class="mb-12" id="instalacja">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-8">Instalacja</h2>
      
      <div class="flex flex-col gap-8">
        <!-- macOS -->
        <div class="bg-white/80 p-6 md:p-8 rounded-2xl border border-amber-200/60 shadow-xs">
          <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
            🍎 macOS (Homebrew)
          </h3>
          <ol class="list-decimal list-inside space-y-2 text-lg text-slate-700">
            <li>
              Zainstaluj Caska z dedykowanego repozytorium:
              <SeparatorNiewidzialny height='0.3'/>
              <PoleKodu>brew install --cask bookoteka/tap/bookoteka</PoleKodu>
            </li>
            <SeparatorNiewidzialny height='0.8'/>
            <li>
              Ważne (Gatekeeper): Ponieważ aplikacja jest projektem Open Source i nie posiada płatnego certyfikatu Apple Developer ID, macOS domyślnie zablokuje jej pierwsze uruchomienie. Aby odblokować aplikację, wykonaj w terminalu jednorazowe polecenie:
              <SeparatorNiewidzialny height='0.3'/>
              <PoleKodu>xattr -d com.apple.quarantine /Applications/Bookoteka.app</PoleKodu>
            </li>
          </ol>
        </div>

        <!-- Windows -->
        <div class="bg-white/80 p-6 md:p-8 rounded-2xl border border-amber-200/60 shadow-xs">
          <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
            🪟 Windows
          </h3>
          <ol class="list-decimal list-inside space-y-2 text-slate-700 text-lg">
            <li>Pobierz instalator <code class="bg-amber-100/60 px-1.5 py-0.5 rounded border border-amber-200/80 text-xs font-mono">.msi</code> lub <code class="bg-amber-100/60 px-1.5 py-0.5 rounded border border-amber-200/80 text-xs font-mono">.exe</code> ze strony <a href="https://github.com/bookoteka/bookoteka/releases/latest" target="_blank" rel="noopener noreferrer" class="text-amber-800 underline hover:text-amber-900 font-medium">repozytorium</a>.</li>
            <li>Uruchom instalator.</li>
            <li>Wyskoczy okienko, że Microsoft Defender zablokował instalację.</li>
            <li>Kliknij <strong>"Więcej informacji"</strong>.</li>
            <li>Kliknij <strong>"Uruchom mimo tego"</strong>.</li>
            <li>Uruchomi się kreator. Podążaj za jego instrukcjami.</li>
          </ol>
        </div>

        <!-- Linux -->
        <div class="bg-white/80 p-6 md:p-8 rounded-2xl border border-amber-200/60 shadow-xs">
          <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
            🐧 Linux
          </h3>
          <p class="text-lg text-slate-700 leading-relaxed">
            Pobierz odpowiedni plik instalacyjny dla swojego systemu z zakładki <a href="https://github.com/bookoteka/bookoteka/releases/latest" target="_blank" rel="noopener noreferrer" class="text-amber-800 underline hover:text-amber-900 font-medium">Releases</a>, uruchom go, a w razie potrzeby systemowego ostrzeżenia (SmartScreen) zezwól na jego wykonanie.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>