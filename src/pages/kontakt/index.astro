---
import Layout from "../../layouts/Layout.astro";

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<Layout title="Kontakt | Bookoteka Apps">
  <section class="py-16 md:py-24 max-w-6xl mx-auto px-6 relative">
    <div class="max-w-3xl mb-12">
      <span class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold text-amber-900 bg-amber-200/60 rounded-full border border-amber-300/50">
        Napisz do nas
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
        Skontaktuj się z Bookoteka Apps
      </h1>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed">
        Masz pytanie, znalazłeś błąd albo chcesz podzielić się pomysłem?
        Chętnie Cię wysłuchamy.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-8 items-start">
      <aside class="bg-amber-100/60 border border-amber-200/80 p-8 rounded-3xl">
        <div class="text-3xl mb-5">💬</div>
        <h2 class="text-2xl font-bold text-slate-900">Jesteśmy otwarci na rozmowę</h2>
        <p class="mt-3 text-slate-700 leading-relaxed">
          Najlepiej opisz dokładnie, czego potrzebujesz. Dzięki temu szybciej
          przygotujemy pomocną odpowiedź.
        </p>
        <div class="mt-8 space-y-4 text-sm text-slate-700">
          <p class="flex gap-3">
            <span aria-hidden="true">⚙️</span>
            <span>Problemy techniczne najlepiej zgłaszać wraz z opisem kroków i wersją aplikacji.</span>
          </p>
          <p class="flex gap-3">
            <span aria-hidden="true">💡</span>
            <span>Pomysły na rozwój możesz przesłać lub dodać bezpośrednio na GitHubie.</span>
          </p>
        </div>
      </aside>

      <form
        id="formularz-kontaktowy"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="bg-white/90 p-6 md:p-8 rounded-3xl border border-amber-200/60 shadow-xs"
      >
        <input type="hidden" name="access_key" value={web3FormsAccessKey} />
        <input type="hidden" name="subject" value="Nowa wiadomość ze strony Bookoteka Apps" />
        <input type="hidden" name="from_name" value="Formularz kontaktowy Bookoteka Apps" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-slate-800 mb-2">Imię</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Twoje imię"
              class="w-full rounded-xl border border-amber-200 bg-amber-50/40 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-slate-800 mb-2">Adres e-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="ty@example.com"
              class="w-full rounded-xl border border-amber-200 bg-amber-50/40 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="message" class="block text-sm font-semibold text-slate-800 mb-2">Wiadomość</label>
          <textarea
            id="message"
            name="message"
            required
            rows="7"
            placeholder="W czym możemy pomóc?"
            class="w-full resize-y rounded-xl border border-amber-200 bg-amber-50/40 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200"
          ></textarea>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-4">
          <button
            id="guzik-wyslij"
            type="submit"
            class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 disabled:opacity-50 text-white font-semibold px-7 py-3.5 rounded-xl transition-all shadow-md hover:shadow-lg cursor-pointer disabled:cursor-not-allowed"
          >
            Wyślij wiadomość
          </button>
          <p class="text-xs text-slate-500 leading-relaxed">
            Wysyłając formularz, zgadzasz się na kontakt zwrotny w sprawie tej wiadomości.
          </p>
        </div>
      </form>
    </div>

    <!-- Powiadomienie Toast -->
    <div
      id="toast-powiadomienie"
      class="fixed bottom-6 right-6 hidden items-center gap-3 bg-emerald-900 text-white px-5 py-4 rounded-2xl shadow-2xl border border-emerald-700 z-50 transition-all transform translate-y-4"
    >
      <span class="text-xl">✅</span>
      <div>
        <p class="font-bold text-sm">Wiadomość została wysłana!</p>
        <p class="text-xs text-emerald-200">Dziękujemy za kontakt, odpowiemy najszybciej jak to możliwe.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const formularz = document.getElementById('formularz-kontaktowy') as HTMLFormElement | null;
  const guzik = document.getElementById('guzik-wyslij') as HTMLButtonElement | null;
  const toast = document.getElementById('toast-powiadomienie');

  formularz?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!guzik) return;
    const oryginalnyTekst = guzik.textContent;
    guzik.disabled = true;
    guzik.textContent = 'Wysyłanie...';

    try {
      const formData = new FormData(formularz);
      const odpowiedz = await fetch(formularz.action, {
        method: 'POST',
        body: formData,
      });

      const wynik = await odpowiedz.json();

      if (wynik.success) {
        formularz.reset();

        if (toast) {
          toast.classList.remove('hidden');
          toast.classList.add('flex');
          setTimeout(() => {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
          }, 4000);
        }
      } else {
        alert('Wystąpił błąd podczas wysyłania. Spróbuj ponownie.');
      }
    } catch {
      alert('Coś poszło nie tak. Sprawdź połączenie z siecią.');
    } finally {
      guzik.disabled = false;
      guzik.textContent = oryginalnyTekst;
    }
  });
</script>